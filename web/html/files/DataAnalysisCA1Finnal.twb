      <layout-options>
        <title>
          <formatted-text>
            <run>Population Awareness about Corropution in Goverment </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='World-happiness-report-updated_2024' name='federated.0ds7xij1fuqcxb13facus0e5o7b2' />
          </datasources>
          <datasource-dependencies datasource='federated.0ds7xij1fuqcxb13facus0e5o7b2'>
            <column caption='Max value of the corruption' datatype='real' name='[Calculation_2070529997388570642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Perceptions of corruption] = { FIXED [Country name] : MAX([Perceptions of corruption]) }&#13;&#10;THEN [Perceptions of corruption]&#13;&#10;END' />
            </column>
            <column caption='Min Value Corruption' datatype='real' name='[Calculation_397161194828976133]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Perceptions of corruption] = { FIXED [Country name] : MIN([Perceptions of corruption]) }&#13;&#10;THEN [Perceptions of corruption]&#13;&#10;END' />
            </column>
            <column caption='Country name1' datatype='string' name='[Country name]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='real' name='[Perceptions of corruption]' role='measure' type='quantitative' />
